SSH_ADDR=:23234
SSH_AUTH_MODE=allowlist
SSH_ALLOWLIST_PATH=./allowlist_authorized_keys
SSH_HOSTKEY_PATH=./.ssh_host_ed25519_key
WOO_BASE_URL=http://127.0.0.1:18080
WOO_STORE_PREFIX=/wp-json/wc/store/v1
STATE_DIR=./var/eva-terminal
CACHE_TTL_SECONDS=60
# Generate with: openssl rand -hex 32. Set the same key in WordPress.
EVA_BRIDGE_KEY=
# Disables new orders only; existing payment recovery continues.
CHECKOUT_ENABLED=false
